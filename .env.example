# Meta App (Meta for Developers > tu app > Configuración básica)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 bytes en base64. Genera uno con: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=

# Protege /api/cron/monitor. Obligatorio en producción. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Supabase (Project Settings > API Keys). Obligatorio: base de datos y autenticación.
# La llave secreta solo se usa en el servidor; nunca le agregues el prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# OpenAI. La llave solo se usa en el servidor; cada usuario elige su modelo en Configuración.
OPENAI_API_KEY=

# Resend (resend.com): resumen semanal por correo a clientes.
# REPORTS_FROM_EMAIL debe usar un dominio verificado en Resend.
RESEND_API_KEY=
REPORTS_FROM_EMAIL="Reportes <reportes@tudominio.com>"
