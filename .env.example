# Meta App (Meta for Developers > tu app > Configuración básica)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 bytes en base64. Genera uno con: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=

# Protege /api/cron/monitor. Obligatorio en producción. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Supabase (Project Settings > API Keys). Obligatorio: base de datos y autenticación.
# La llave secreta solo se usa en el servidor; nunca le agregues el prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# IA generativa. La clave jamás se expone al navegador.
# Valores: local | openai | openai-compatible | gemini | custom
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Para cualquier proveedor que use una API compatible con OpenAI.
# AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
