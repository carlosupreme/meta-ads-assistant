# Meta App (Meta for Developers > tu app > Configuración básica)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 bytes en base64. Genera uno con: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=

# Protege /api/cron/monitor. Obligatorio en producción (Vercel lo envía automáticamente).
CRON_SECRET=

# Supabase Database (Project Settings > API Keys). Solo se usan en el servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase Auth (Project Settings > API Keys > Publishable key). Usa el mismo SUPABASE_URL.
# Con esta llave y la base de datos configurada, Pulso exige iniciar sesión.
# También se acepta NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY si ya está disponible al compilar.
SUPABASE_PUBLISHABLE_KEY=

# Instalaciones previas de un solo usuario: el workspace PULSO_WORKSPACE_ID sin dueño
# pasa a la primera cuenta que inicie sesión con este correo.
PULSO_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
PULSO_LEGACY_OWNER_EMAIL=

# IA generativa. La clave jamás se expone al navegador.
# Valores: local | openai | openai-compatible | gemini | custom
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Para cualquier proveedor que use una API compatible con OpenAI.
# AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
